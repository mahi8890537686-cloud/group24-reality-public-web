# Copy this file to .env.local for local development.
# In Vercel: Project Settings → Environment Variables — add every key below
# (Production + Preview + Development as appropriate). Do NOT commit real
# values anywhere — this file is a template only.

# ─── Firebase Client SDK (public — safe to expose to the browser) ───────────
# From Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-only — NEVER prefix with NEXT_PUBLIC_) ──────
# From Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Use the values from the downloaded JSON, not the JSON file
# itself. FIREBASE_ADMIN_PRIVATE_KEY must keep its literal \n line breaks —
# in the Vercel dashboard, paste it as one line with \n sequences intact
# (Vercel's env var editor stores it correctly as-is; do not manually insert
# real newlines).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Misc ────────────────────────────────────────────────────────────────────
# Currently unused in application code (found via grep) — kept for parity
# with .env.local. Safe to omit from Vercel if you confirm it's not needed.
NEXT_PUBLIC_ADMIN_EMAIL=
