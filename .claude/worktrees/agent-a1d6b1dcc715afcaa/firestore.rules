rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Locations: public read, admin write
    match /locations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Projects: public read, admin write
    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Properties: public read, admin write
    match /properties/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blogs: public read, admin write
    match /blogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Testimonials: public read, admin write
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site Config: public read, admin write
    // Stores business contact info, social links, office hours, etc.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Leads: anyone can create, only admins can read/update/delete
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Enquiries: anyone can create, only admins can read/update/delete
    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // CRM Contacts: admin only
    match /crm_contacts/{docId} {
      allow read, write: if request.auth != null;
    }

    // CRM Templates: admin only
    match /crm_templates/{docId} {
      allow read, write: if request.auth != null;
    }

    // WhatsApp Messages: admin only
    match /wa_messages/{docId} {
      allow read, write: if request.auth != null;
    }

    // WhatsApp Campaigns: admin only
    match /wa_campaigns/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
