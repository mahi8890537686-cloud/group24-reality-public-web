rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Property images: anyone can read, only authenticated users can write
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // 10 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Booking documents (KYC, allotment letters): private — signed-in read/write only.
    match /bookings/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024  // 15 MB max
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
